BUSAN_THEME_API_KEY=
DATABASE_URL=
LLM_API_KEY=
PUBLIC_API_URL=

# ── 로그인 경보 자동화 봇 (실습 과제) ──
# board_server(app.py) 의 POST /api/security/events 인증 키. n8n 이 이 값으로 X-API-Key 헤더를 보낸다.
SECURITY_API_KEY=
AUTO_POST_ON_DENY=

# alert_sender.py 가 POST 할 n8n Webhook 주소 (n8n 워크플로우의 Webhook 노드 URL)
N8N_WEBHOOK_URL=

# n8n 워크플로우의 HTTP Request 노드가 {{$env["..."]}} 로 참조하는 알림 채널 값
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# n8n 워크플로우 마지막 단계가 저장을 요청할 board_server 주소
# n8n 이 Docker 컨테이너에서 도는 경우 localhost 는 컨테이너 자신을 가리키므로 host.docker.internal 사용
BOARD_API_URL=

# n8n 최신 버전은 보안상 노드 표현식에서 {{$env["..."]}} 접근을 기본 차단한다.
# 이 프로젝트에서는 웹훅 URL 등을 하드코딩하지 않고 env 로 참조하려는 목적이므로 명시적으로 허용한다.
N8N_BLOCK_ENV_ACCESS_IN_NODE=